{
  "name": "dsh-compaction-lcm",
  "version": "0.2.8",
  "description": "Lossless Context Management compaction engine for the DeepSeek Harness — LLM leaf summaries over an append-only log, with lcm_expand/lcm_search recovery",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./compiler": {
      "default": "./src/compiler.js"
    },
    "./region": {
      "default": "./src/region.js"
    },
    "./recall": {
      "default": "./src/recall.js"
    },
    "./search": {
      "default": "./src/search.js"
    },
    "./summarize": {
      "default": "./src/summarize.js"
    },
    "./tool": {
      "default": "./src/tool.js"
    },
    "./command": {
      "default": "./src/command.js"
    },
    "./package.json": "./package.json",
    "./config": {
      "default": "./src/config.js"
    }
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/summarize.js && node --check src/region.js && node --check src/compiler.js && node --check src/tool.js && node --check src/command.js && node --check src/recall.js && node --check src/search.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cordis",
    "dsh",
    "deepseek-harness",
    "compaction",
    "lcm",
    "lossless-context"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-compaction": "^0.2.0",
    "@deepseek-ai/dsh-llm": "^0.2.0",
    "@deepseek-ai/dsh-session": "^0.2.0",
    "@deepseek-ai/dsh-token-meter": "^0.2.0",
    "@deepseek-ai/dsh-tools": "^0.2.0",
    "@deepseek-ai/dsh-util-values": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
