{
  "name": "dsh-lcm",
  "version": "0.29.0",
  "description": "Lossless Context Management compaction engine for the DeepSeek Harness — LLM leaf summaries over an append-only log, with lcm_expand/lcm_search recovery",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./compiler": {
      "default": "./src/compiler.js"
    },
    "./region": {
      "default": "./src/region.js"
    },
    "./recall": {
      "default": "./src/recall.js"
    },
    "./search": {
      "default": "./src/search.js"
    },
    "./vectors": {
      "default": "./src/vectors.js"
    },
    "./summarize": {
      "default": "./src/summarize.js"
    },
    "./tool": {
      "default": "./src/tool.js"
    },
    "./command": {
      "default": "./src/command.js"
    },
    "./gate": {
      "default": "./gate/index.js"
    },
    "./package.json": "./package.json",
    "./config": {
      "default": "./src/config.js"
    },
    "./insight": {
      "default": "./src/insight.js"
    },
    "./client": "./client.js"
  },
  "files": [
    "src",
    "gate",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "config.example.yaml",
    "docs",
    "bench/REPORT.md",
    "bench/METHODOLOGY.md"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/summarize.js && node --check src/region.js && node --check src/compiler.js && node --check src/tool.js && node --check src/command.js && node --check src/recall.js && node --check src/search.js && node --check src/vectors.js && node --check gate/index.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cordis",
    "dsh",
    "deepseek-harness",
    "compaction",
    "lcm",
    "lossless-context"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-compaction": ">=0.2.2-0 <0.3.0-0 || >=0.2.3-0 <0.3.0-0 || >=0.2.4-0 <0.3.0-0 || >=0.2.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-0 <0.3.0-0 || >=0.2.3-0 <0.3.0-0 || >=0.2.4-0 <0.3.0-0 || >=0.2.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-0 <0.3.0-0 || >=0.2.3-0 <0.3.0-0 || >=0.2.4-0 <0.3.0-0 || >=0.2.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-token-meter": ">=0.2.2-0 <0.3.0-0 || >=0.2.3-0 <0.3.0-0 || >=0.2.4-0 <0.3.0-0 || >=0.2.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-0 <0.3.0-0 || >=0.2.3-0 <0.3.0-0 || >=0.2.4-0 <0.3.0-0 || >=0.2.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-util-values": ">=0.2.2-0 <0.3.0-0 || >=0.2.3-0 <0.3.0-0 || >=0.2.4-0 <0.3.0-0 || >=0.2.5-0 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-token-meter": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-util-values": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
